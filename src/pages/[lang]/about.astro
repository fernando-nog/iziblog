---
import PageLayout from '../../layouts/PageLayout.astro';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'pt' } }];
}

const { lang } = Astro.params;
---

<PageLayout title={t('about.title', lang)} description={lang === 'pt' ? 'Sobre o IziBlog — um template Astro simples e otimizado para SEO para blogs técnicos.' : 'About IziBlog — a simple, SEO-first Astro template for technical blogs.'} lang={lang}>
  <h1 class="page-title">{t('about.title', lang)}</h1>

  <div class="page-prose">
    {lang === 'pt' ? (
      <>
        <p>O IziBlog é um template Astro limpo e otimizado para SEO para escritores técnicos e desenvolvedores que querem um blog rápido, em Markdown, com recursos modernos de publicação.</p>

        <h2>Recursos</h2>
        <ul>
          <li>Conteúdo Markdown / MDX com Astro Content Collections</li>
          <li>RSS, sitemap e dados estruturados (JSON-LD)</li>
          <li>Suporte a tema escuro / claro / sistema</li>
          <li>Busca estática (pronto para Pagefind)</li>
          <li>Suporte a <code>llms.txt</code> e <code>llms-full.txt</code></li>
          <li>Consentimento de cookies sem rastreamento</li>
          <li>Navegação por tags e arquivo por ano</li>
          <li>Acessível, responsivo e rápido por padrão</li>
        </ul>

        <h2>Começando</h2>
        <ol>
          <li>Clone este repositório ou use-o como template do GitHub.</li>
          <li>Edite <code>src/config/site.ts</code> com seus metadados.</li>
          <li>Adicione posts em <code>src/content/blog/</code> como Markdown ou MDX.</li>
          <li>Execute <code>npm run dev</code> para iniciar o servidor de desenvolvimento.</li>
          <li>Execute <code>npm run build</code> para gerar o site estático.</li>
        </ol>

        <h2>Personalização</h2>
        <p>O template usa propriedades CSS customizadas para temas. Edite <code>src/styles/global.css</code> para alterar cores, fontes e espaçamentos. Veja <code>docs/CUSTOMIZATION.md</code> para mais detalhes.</p>

        <h2>Licença</h2>
        <p>Licença MIT. Você é livre para usar, modificar e distribuir este template.</p>
      </>
    ) : (
      <>
        <p>IziBlog is a clean, SEO-first Astro template for technical writers and developers who want a fast, Markdown-first blog with modern publishing features.</p>

        <h2>Features</h2>
        <ul>
          <li>Markdown / MDX content with Astro Content Collections</li>
          <li>RSS, sitemap, and structured data (JSON-LD)</li>
          <li>Dark / light / system theme support</li>
          <li>Static search (Pagefind-ready)</li>
          <li><code>llms.txt</code> and <code>llms-full.txt</code> support</li>
          <li>Privacy-friendly cookie consent</li>
          <li>Tag-based navigation and archive by year</li>
          <li>Accessible, responsive, fast by default</li>
        </ul>

        <h2>Getting started</h2>
        <ol>
          <li>Clone this repository or use it as a GitHub template.</li>
          <li>Edit <code>src/config/site.ts</code> with your metadata.</li>
          <li>Add posts to <code>src/content/blog/</code> as Markdown or MDX.</li>
          <li>Run <code>npm run dev</code> to start the dev server.</li>
          <li>Run <code>npm run build</code> to generate the static site.</li>
        </ol>

        <h2>Customization</h2>
        <p>The template uses CSS custom properties for theming. Edit <code>src/styles/global.css</code> to change colors, fonts, and spacing. See <code>docs/CUSTOMIZATION.md</code> for more details.</p>

        <h2>License</h2>
        <p>MIT License. You are free to use, modify, and distribute this template.</p>
      </>
    )}
  </div>

  <style>
.page-prose { max-width: var(--max-content); }
.page-prose p { font-size: 1.0625rem; line-height: 1.75; margin-bottom: 20px; color: var(--fg); opacity: .92; }
.page-prose h2 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 44px; margin-bottom: 16px; color: var(--fg); }
.page-prose ul, .page-prose ol { list-style: disc; padding-left: 24px; margin-bottom: 20px; }
.page-prose ol { list-style: decimal; }
.page-prose li { font-size: 1.0625rem; line-height: 1.7; margin-bottom: 8px; color: var(--fg); opacity: .92; }
.page-prose code { font-family: var(--font-mono); font-size: .94em; background: oklch(92% 0.004 260); color: var(--fg); padding: 2px 5px; border-radius: 4px; }
html.dark .page-prose code { background: oklch(28% 0.012 260); }
  </style>
</PageLayout>
