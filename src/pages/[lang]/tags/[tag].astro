---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, getAllTags, type Post } from '../../../lib/posts';
import { t } from '../../../lib/i18n';
import type { Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  const paths: { params: { lang: string; tag: string }; props: { tag: string } }[] = [];
  for (const [tag] of tags) {
    paths.push({ params: { lang: 'en', tag }, props: { tag } });
    paths.push({ params: { lang: 'pt', tag }, props: { tag } });
  }
  return paths;
}

const { tag, lang } = Astro.params as { tag: string; lang: Lang };
const allPosts = await getPublishedPosts(lang);
const posts = allPosts.filter((post: Post) => post.data.tags.includes(tag));
const count = posts.length;
const pluralS = count !== 1 ? 's' : '';
---

<BaseLayout title={`${t('tags.title', lang)}: ${tag}`} description={`${t('articles.title', lang)} tagged with "${tag}".`} lang={lang}>
  <div class="container">
    <div class="main">
      <h1 class="page-title">{t('tags.title', lang)}: {tag}</h1>
      <p class="page-sub">{count} {t('tag.postsTagged', lang).replace('{s}', pluralS)} "{tag}".</p>
      <div style="border-top: 1px solid var(--border);">
        {posts.map((post: Post) => <PostCard post={post} lang={lang} prefetch />)}
      </div>
    </div>
  </div>
</BaseLayout>
